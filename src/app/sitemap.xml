import type { MetadataRoute } from "next";
import { site } from "@/data/site";
import { treatments } from "@/data/treatments";
import { posts } from "@/data/blog";

export default function sitemap(): MetadataRoute.Sitemap {
  const staticRoutes = [
    "",
    "/about",
    "/treatments",
    "/locations",
    "/locations/madurai",
    "/locations/theni",
    "/gallery",
    "/blogs",
    "/contact",
    "/book",
  ];

  const treatmentRoutes = treatments.map((t) => `/treatments/${t.slug}`);
  const blogRoutes = posts.map((p) => `/blogs/${p.slug}`);

  const routes = [
    ...staticRoutes,
    ...treatmentRoutes,
    ...blogRoutes,
  ];

  return routes.map((route) => ({
    url: `${site.url}${route}`,
    lastModified: new Date(),
    changeFrequency:
      route === ""
        ? "weekly"
        : route.startsWith("/blogs")
          ? "weekly"
          : "monthly",
    priority:
      route === ""
        ? 1
        : route === "/blogs"
          ? 0.8
          : 0.7,
  }));
}